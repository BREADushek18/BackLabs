{
  "compilerOptions": {
    "target": "ES2020",                                  
    "module": "commonjs",    
    "moduleResolution": "node10",                    
    "rootDir": "./src",                                 
    "typeRoots": [
      "./node_modules/@types",
      "courses-service/src/types"
    ],                                  
    "outDir": "./dist",                                 
    "esModuleInterop": true,                             
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                     
    "skipLibCheck": true,  
    "noImplicitAny": false,       
  },
  "include": ["src/**/*", "courses-service/**/*", "user-service/**/*"],
  "exclude": ["node_modules"]
}
