{
  "compilerOptions": {

    "target": "ES2020",                                   
    "module": "CommonJS",                               
    "moduleResolution": "node10",                
    "typeRoots": [
      "./node_modules/@types",
      "courses-service/src/types"
    ],                                 
    "types": ["node", "express"],                                    
    "outDir": "./dist",                    
    "esModuleInterop": true,                            
    "forceConsistentCasingInFileNames": true,           
    "strict": true,                                     
    "skipLibCheck": true                                 
  },
  "include": ["src/**/*", "courses-service/**/*", "user-service/**/*"],
  "exclude": ["node_modules"]
}
